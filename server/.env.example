# CHARIS Server Environment Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db" # Or postgresql://user:pass@ep-xxx.supabase.co:5432/charis
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"

# AI Inference Settings (Ollama local inference or fallback)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5" # Options: qwen2.5, llama3, mistral
